{
  "name": "gui2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cp ../process/project.lua ./src/assets/project.lua && vite",
    "build": "vite build --emptyOutDir && cp ../process/project.lua ./build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/svelte": "^5.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@tsconfig/svelte": "^5.0.4",
    "arconnect": "^1.0.3",
    "flowbite": "^2.5.1",
    "flowbite-svelte": "^0.46.15",
    "flowbite-svelte-blocks": "^1.1.3",
    "flowbite-svelte-icons": "^1.6.1",
    "flowbite-typography": "^1.0.3",
    "jsdom": "^24.1.1",
    "svelte": "5.0.0-next.216",
    "svelte-check": "^3.8.5",
    "tailwindcss": "^3.4.7",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@permaweb/aoconnect": "^0.0.58"
  }
}
